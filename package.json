{
  "name": "samrthomeaegnt",
  "version": "1.0.0",
  "description": "智能家居 AI Agent - + MCP Server",
  "type": "module",
  "main": "src/agent.js",
  "scripts": {
    "start": "node src/agent.js",
    "dev": "node --watch src/agent.js",
    "setup": "npm install && npm run setup-mcp",
    "setup-mcp": "node scripts/setup-mcp.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/smoke/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:smoke": "node --test tests/smoke/*.test.js",
    "test:cov": "node --test --experimental-test-coverage tests/unit/*.test.js tests/integration/*.test.js tests/smoke/*.test.js"
  },
  "keywords": [
    "smart-home",
    "ai-agent",
    "mcp",
    "home-assistant",
    "xiaomi"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.66.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mcporter": "^0.12.0",
    "node-cron": "^4.2.1",
    "openai": "^6.42.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
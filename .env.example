# SmartHomeClaw 环境变量配置示例模板
# 使用前请复制为 .env 并填入实际值：cp .env.example .env

# 模型 API Key
# 魔搭 ModelScope（config/agent.yaml ，缺失会导致启动失败）
NVIDIA_API_KEY=your_nvidia_api_key_here
# 火山引擎
VOLCENGINE_API_KEY=your_volcengine_api_key_here

# 飞书 (Lark) 配置
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here

# 百度 API
BAIDU_API_KEY=your_baidu_api_key_here

# 小度
XIAODU_ACCESS_TOKEN=your_xiaodu_access_token_here

# 悠瑞智能家居 MCP 服务器配置
UREAL_TOKEN=your_ureal_token_here
UREAL_APP_KEY=your_ureal_app_key_here

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Home Assistant (HA) 访问令牌
HA_TOKEN=your_home_assistant_long_lived_token_here

